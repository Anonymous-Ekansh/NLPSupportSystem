  "updated": "2026-10-31",
  "description": "Single tunable policy for Level-2 agents (A3 route, A4 audit, A5 coordinate). Rewritten by scripts/tune_a3_policy.py from DEV only; never tuned on TEST.",
  "threshold_notes": {
    "confidence_high": "at or above this, A1 is trusted when margin is also healthy",
    "confidence_low": "below this A3 escalates (no answer attempt)",
    "top2_margin_min": "below this the top-2 hypotheses are treated as ambiguous",
    "ood_similarity_min": "A3 escalation floor for query/neighbour similarity. Deliberately lower than a1_config.json s_min (0.770013), which is calibrated on full-length dataset instructions and flags valid short user queries. Measured on 2026-10-30: clearly out-of-domain queries ('weather in Paris', 'write a poem', 'tell me a joke') score 0.24-0.34; short in-domain queries ('cancel my order', 'where is my order 998877') score 0.72-0.93. 0.55 catches clear OOD without escalating valid short requests; ambiguous adjacent-domain queries (~0.66-0.70) are left to confidence/ambiguity rules.",
    "similarity_min": "A4 check: query/source-instruction cosine A2 requires (a2 SIM_MIN is 0.9107)",
    "neighbor_agreement_min": "A4 check: share of retrieved neighbours that agree with the predicted intent"
  },
